PORT=3000
GLOW_ALLOWED_HOSTS=localhost,127.0.0.1
GLOW_PUBLIC_MCP_URL=http://127.0.0.1:3000/mcp-v2

# Remote protected-service mode
GLOW_PROTECTED_SERVICE_URL=https://protected-service.example
GLOW_PROTECTED_SERVICE_TOKEN=replace-at-deployment

# Combined staging mode
# Set only inside the private assembly/deployment environment.
# The public repository does not provide or publish the protected runtime module.
# GLOW_COMBINED_RUNTIME_MODULE=/absolute/or/runtime-relative/module.mjs
# GLOW_STAGING_UI_ENABLED=1
# GLOW_STAGING_ACCESS_CODE=replace-with-staging-secret
# GLOW_AUTH_MODE=staging_disabled
# GLOW_NODE_STATE_DIR=.glow-node-state

# R3 bounded host test only (never copy these defaults into production):
# GLOW_AUTH_MODE=static_bearer
# GLOW_PUBLIC_TEST_BEARER_TOKEN=replace-with-32-plus-character-secret
# GLOW_PUBLIC_TEST_SUBJECT=hostinger-r3-test-user

# Production / combined OAuth path:
# GLOW_AUTH_MODE=oauth
# GLOW_OAUTH_ISSUER=https://identity.example
# GLOW_OAUTH_AUDIENCE=https://glow-education.example/mcp-v2
# GLOW_OAUTH_JWKS_URL=https://identity.example/.well-known/jwks.json
# GLOW_OAUTH_REQUIRED_SCOPES=email

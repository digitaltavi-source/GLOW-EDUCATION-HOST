{
  "schema_version": "0.2.0",
  "profile_id": "GLOW_EDUCATION_HOSTINGER_PUBLIC_OR_COMBINED",
  "state": "LIVE_DEMO_HOST_VERIFIED_NOT_PRODUCTION",
  "purpose": "Deploy the public GLOW Education Host on Hostinger managed Node.js hosting, either against a remote protected service or with a private runtime injected by an authorized combined assembly.",
  "source": {
    "repository": "digitaltavi-source/GLOW-EDUCATION-HOST",
    "branch": "main"
  },
  "runtime": {
    "node_version": "22.x",
    "repository_root": ".",
    "build_command": "npm install --ignore-scripts --no-audit --no-fund && npm run build",
    "start_command": "npm start",
    "health_path": "/healthz",
    "readiness_path": "/readyz",
    "browser_path": "/",
    "mcp_path": "/mcp-v2"
  },
  "deployment_modes": {
    "remote_protected_service": {
      "required": [
        "GLOW_PROTECTED_SERVICE_URL",
        "GLOW_PROTECTED_SERVICE_TOKEN"
      ],
      "topology": "PUBLIC_HOST -> HTTPS_PROTECTED_SERVICE"
    },
    "combined_staging": {
      "required": [
        "GLOW_COMBINED_RUNTIME_MODULE",
        "GLOW_STAGING_UI_ENABLED",
        "GLOW_STAGING_ACCESS_CODE"
      ],
      "topology": "ONE_DOMAIN -> PUBLIC_HOST -> IN_PROCESS_PROTECTED_RUNTIME",
      "runtime_module_source": "PRIVATE_ASSEMBLY_ONLY",
      "private_module_published_in_public_repo": false
    }
  },
  "common_environment": [
    "GLOW_ALLOWED_HOSTS",
    "GLOW_PUBLIC_MCP_URL",
    "GLOW_AUTH_MODE"
  ],
  "security": {
    "public_repo_contains_private_factory_source": false,
    "private_runtime_path_hardcoded_in_public_repo": false,
    "secrets_committed": false,
    "model_session_private_allowed_on_browser_combined_path": false,
    "unknown_public_response_fields": "FAIL_CLOSED",
    "combined_private_exposure": "FAIL_CLOSED"
  },
  "claims": {
    "host_build_verified": true,
    "combined_interface_verified": true,
    "live_hostinger_combined_deployment_verified": true,
    "production_qualified": false
  },
  "next_gate": "PERSISTENCE_REPRODUCTION_AND_PUBLIC_REVIEW_IF_DESIRED"
}

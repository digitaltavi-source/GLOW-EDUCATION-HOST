{
  "schema_version": "0.1.0",
  "profile_id": "GLOW_EDUCATION_HOSTINGER_PUBLIC_MCP",
  "state": "CANDIDATE_NOT_LIVE",
  "purpose": "Deploy the declassified public ChatGPT/MCP host on Hostinger managed Node.js hosting.",
  "source": {
    "repository": "digitaltavi-source/GLOW-EDUCATION-HOST",
    "branch": "candidate/chatgpt-host-v0.1.0"
  },
  "runtime": {
    "node_version": "22.x",
    "repository_root": ".",
    "build_command": "npm install --ignore-scripts && npm run build",
    "start_command": "npm start",
    "health_path": "/healthz",
    "mcp_path": "/mcp"
  },
  "required_environment": [
    {
      "name": "GLOW_PROTECTED_SERVICE_URL",
      "secret": false,
      "required": true,
      "meaning": "HTTPS URL of the live private Factory host"
    },
    {
      "name": "GLOW_PROTECTED_SERVICE_TOKEN",
      "secret": true,
      "required": true,
      "meaning": "Same bearer secret configured on private host"
    },
    {
      "name": "GLOW_PUBLIC_MCP_URL",
      "secret": false,
      "required": true,
      "meaning": "Public HTTPS MCP endpoint, ending in /mcp"
    },
    {
      "name": "GLOW_ALLOWED_HOSTS",
      "secret": false,
      "required": true,
      "meaning": "Public host/domain allowlist"
    },
    {
      "name": "GLOW_OAUTH_ISSUER",
      "secret": false,
      "required": true
    },
    {
      "name": "GLOW_OAUTH_AUDIENCE",
      "secret": false,
      "required": true
    },
    {
      "name": "GLOW_OAUTH_JWKS_URL",
      "secret": false,
      "required": true
    }
  ],
  "security": {
    "private_assets_embedded": false,
    "private_release_hashes_public": false,
    "model_session_private_is_public_delivery": false,
    "protected_backend_unavailable": "FAIL_CLOSED"
  },
  "claims": {
    "hostinger_deployed": false,
    "publicly_reachable": false,
    "oauth_live": false,
    "chatgpt_connected": false,
    "app_directory_approved": false
  },
  "next_gate": "CREATE_HOSTINGER_PUBLIC_APP_AFTER_PRIVATE_APP_HAS_LIVE_HTTPS_URL"
}
